load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

cc_library(
    name = "mylib",
    srcs = glob(
        ["src/**/*.cc"],
        allow_empty = True,
        exclude = ["src/main.cc"],
    ),
    hdrs = glob(["include/**/*.h"]),
    copts = select({
        "@platforms//os:windows": ["/std:c++20"],
        "//conditions:default": ["-std=c++20"],
    }),
    includes = ["include"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "textures",
    srcs = glob(["assets/textures/**"]),
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "tetris",
    srcs = ["src/main.cc"],
    copts = select({
        "@platforms//os:windows": ["/std:c++20"],
        "//conditions:default": ["-std=c++20"],
    }),
    data = [":textures"],
    deps = [":mylib"],
)
